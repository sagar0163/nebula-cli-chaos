{
  "name": "nebula-cli-chaos",
  "version": "2.0.0",
  "description": "Chaos testing framework for CLI applications",
  "main": "test-runner.js",
  "bin": {
    "nebula": "chaos-runner.js",
    "nebula-chaos": "chaos-runner.js"
  },
  "scripts": {
    "build": "node --check chaos-runner.js && node --check test-runner.js && node --check fault-injection.js",
    "test": "node chaos-runner.js",
    "test:network": "node chaos-runner.js --category=network",
    "test:memory": "node chaos-runner.js --category=memory",
    "test:concurrency": "node chaos-runner.js --category=concurrency",
    "test:fuzz": "node chaos-runner.js --category=fuzz",
    "test:stress": "node chaos-runner.js --category=stress",
    "test:fault-injection": "node chaos-runner.js --category=fault-injection"
  },
  "keywords": ["chaos", "testing", "cli", "nebula"],
  "files": [
    "chaos-runner.js",
    "test-runner.js",
    "fault-injection.js",
    "chaos.config.json",
    "fixtures/",
    "README.md",
    "LICENSE"
  ],
  "author": "Sagar",
  "license": "MIT"
}
